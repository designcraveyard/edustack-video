{
  "name": "edustack-video",
  "version": "0.8.1",
  "description": "Educational explainer video pipeline plugin. fal.ai + ElevenLabs, 5-phase video generation with 4 chat-driven review gates, MoviePy stitching, VPS observability — plus an optional Book branch that produces curated transparent-BG illustrations at A4P/A3L 300 DPI via fal-ai/gpt-image-2.",
  "homepage": "https://github.com/designcraveyard/edustack-video",
  "license": "MIT",
  "commands": [
    "commands/create-video.md",
    "commands/create-video-setup.md",
    "commands/create-video-resume.md",
    "commands/create-video-regen.md",
    "commands/create-video-support.md",
    "commands/create-book-regen.md",
    "commands/create-book-from-keyframes.md",
    "commands/create-book.md",
    "commands/test-logs.md",
    "commands/plugin-update.md",
    "commands/plugin-info.md",
    "commands/plugin-rollback.md"
  ],
  "skills": [
    "skills/orchestrator",
    "skills/setup",
    "skills/brief-collector",
    "skills/script-writer",
    "skills/vo-generator",
    "skills/character-sheet-generator",
    "skills/storyboard-generator",
    "skills/clip-generator",
    "skills/stitcher",
    "skills/book-plan",
    "skills/book-render",
    "skills/book-print-prep",
    "skills/book-from-keyframes",
    "skills/book-standalone",
    "skills/book-template-picker"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ship-chat.sh", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ship-chat.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
